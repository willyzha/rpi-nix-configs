# ==============================================================================
# Raspberry Pi NixOS Docker Rebuild Configuration
# Copy this file to .env to customize default deployment parameters:
#   cp .env.example .env
# ==============================================================================

# Default node to target (pi-primary or pi-secondary)
TARGET_HOST=pi-primary

# Target IP address or hostname. If left empty, defaults to:
#   pi-primary   -> 192.168.1.11
#   pi-secondary -> 192.168.1.12
# You can also use Tailscale IPs (e.g. 100.64.0.x) or mDNS (.local)
TARGET_IP=

# Deployment Action:
#   boot        (Default) Build on host, copy closure, set next boot generation, and clean reboot.
#               Highly recommended for 1GB Pi 3B nodes to avoid brownouts/voltage drops.
#   switch      Build on host, copy closure, and switch running services immediately.
#   test        Build on host, copy closure, and test services without modifying bootloader.
#   build-only  Build locally in Docker without connecting or copying to the Pi.
#   image       Build bootable SD card image (.img.zst) and export to ./output/.
ACTION=boot

# Target SSH user (root has SSH key configured by default in modules/common.nix)
TARGET_USER=root

# Optional explicit private SSH key path inside the container (mounted from ~/.ssh on host).
# By default, all private keys in ~/.ssh and any running SSH agent are automatically detected and tried.
# Leave empty unless you want to force a specific key:
SSH_KEY=

# Automatically reboot the Pi after a successful 'boot' action
REBOOT=true
